{
  "name": "ndlocr-lite-web-ai",
  "private": true,
  "version": "0.15.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node -e \"const fs=require('fs');fs.mkdirSync('public/wasm',{recursive:true});fs.copyFileSync('node_modules/onnxruntime-web/dist/ort-wasm-simd.wasm','public/wasm/ort-wasm-simd.wasm');\"",
    "build": "tsc -b && vite build",
    "postbuild": "node -e \"const fs=require('fs'),src='src-tauri/resources/models',dst='dist/models';try{const s=fs.lstatSync(dst);if(s.isSymbolicLink()){fs.unlinkSync(dst);fs.mkdirSync(dst,{recursive:true});fs.readdirSync(src).filter(f=>f.endsWith('.onnx')).forEach(f=>fs.copyFileSync(src+'/'+f,dst+'/'+f));console.log('postbuild: replaced dist/models symlink with real files');}}catch(e){console.warn('postbuild models:',e.message);}\"",
    "lint": "eslint .",
    "preview": "vite preview",
    "mcp-server": "node scripts/test-mcp-server.mjs",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "diff-match-patch": "^1.0.5",
    "heic2any": "^0.0.4",
    "js-yaml": "^4.1.0",
    "onnxruntime-web": "^1.17.3",
    "pdfjs-dist": "^4.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tauri-apps/cli": "^2.11.2",
    "@types/diff-match-patch": "^1.0.36",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/utif": "^3.0.6",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.0"
  },
  "allowScripts": {
    "esbuild@0.27.3": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.5.4": true
  }
}
